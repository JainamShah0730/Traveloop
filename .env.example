# ── Database (Supabase PostgreSQL) ──────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-me"

# ── AI (Gemini 1.5 Flash — free tier) ──────────────────────
GEMINI_API_KEY="your-google-gemini-api-key"

# ── Weather (OpenWeatherMap — free tier) ────────────────────
OPENWEATHER_API_KEY="your-openweather-api-key"

# ── Frontend ────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── Server ──────────────────────────────────────────────────
PORT=3000

# ── AI (DeepSeek) ───────────────────────────────────────────
# Used for the flagship AI Copilot, flight/hotel generation, and journaling
DEEPSEEK_API_KEY="your-deepseek-api-key"

# ── Images (Pexels) ─────────────────────────────────────────
# Used for fetching dynamic city and destination photos
PEXELS_API_KEY="your-pexels-api-key"

# ── Flights & Travel Data (Duffel) ──────────────────────────
# Used for real-time flight option generation
DUFFEL_ACCESS_TOKEN="your-duffel-access-token"

# ── Redis (Upstash) ─────────────────────────────────────────
# Used for caching, rate limiting, and other key-value storage needs
UPSTASH_REDIS_REST_URL="your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ── Email (Resend) ──────────────────────────────────────────
# Used for sending transactional emails and alerts
RESEND_API_KEY="your-resend-api-key"
