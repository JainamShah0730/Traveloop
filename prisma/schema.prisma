// Traveloop — Travel Planning App
// Prisma Schema for PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum ActivityType {
  food
  sightseeing
  transport
  hotel
  shopping
  other
}

// ──────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password_hash String?
  avatar_url    String?
  role          String         @default("user")
  provider      String         @default("email")
  created_at    DateTime       @default(now())

  trips         Trip[]
  collaborators Collaborator[]
  budgets       Budget[]
  price_alerts  PriceAlert[]

  // Wave 1 relations
  aiItineraries      AiItinerary[]
  votes              Vote[]
  journals           Journal[]
  journalLikes       JournalLike[]
  journalComments    JournalComment[]

  // Wave 2: AI Travel Agent
  agentJobs          AgentJob[]

  @@map("users")
}

model Trip {
  id           String         @id @default(cuid())
  user_id      String
  name         String
  cover_photo  String?
  start_date   DateTime
  end_date     DateTime
  total_budget Float          @default(0)
  slug         String         @unique
  is_public    Boolean        @default(false)
  created_at   DateTime       @default(now())

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  stops         Stop[]
  collaborators Collaborator[]
  packing_items PackingItem[]
  notes         Note[]

  // Wave 1 relations
  aiItineraries AiItinerary[]
  polls         Poll[]
  expenses      Expense[]
  settlements   Settlement[]
  journal       Journal?

  @@map("trips")
}

model Stop {
  id          String     @id @default(cuid())
  trip_id     String
  city_name   String
  country     String
  lat         Float
  lng         Float
  from_date   DateTime
  to_date     DateTime
  order_index Int
  created_at  DateTime   @default(now())

  trip       Trip       @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  activities Activity[]
  budgets    Budget[]

  @@map("stops")
}

model Activity {
  id            String       @id @default(cuid())
  stop_id       String
  name          String
  type          ActivityType
  cost          Float        @default(0)
  duration_mins Int          @default(60)
  is_paid       Boolean      @default(false)
  notes         String?
  created_at    DateTime     @default(now())

  stop Stop @relation(fields: [stop_id], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Budget {
  id         String   @id @default(cuid())
  stop_id    String
  paid_by    String
  label      String
  amount     Float
  split_with Json     @default("[]")
  created_at DateTime @default(now())

  stop Stop @relation(fields: [stop_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [paid_by], references: [id], onDelete: Cascade)

  @@map("budgets")
}

model Collaborator {
  id        String   @id @default(cuid())
  trip_id   String
  user_id   String
  role      String   @default("editor")
  joined_at DateTime @default(now())

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([trip_id, user_id])
  @@map("collaborators")
}

model PackingItem {
  id         String  @id @default(cuid())
  trip_id    String
  name       String
  category   String
  is_checked Boolean @default(false)

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("packing_items")
}

model Note {
  id            String   @id @default(cuid())
  trip_id       String
  title         String?
  type          String   @default("ideas")
  content       String
  has_reminder  Boolean  @default(false)
  reminder_time DateTime?
  is_read       Boolean  @default(false)
  updated_at    DateTime @updatedAt

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Destination {
  id          String          @id @default(cuid())
  name        String
  country     String
  region      String?
  type        String
  cover_photo String?
  description String
  is_active   Boolean         @default(true)
  packages    TravelPackage[]

  @@map("destinations")
}

model TravelPackage {
  id                     String       @id @default(cuid())
  destination_id         String
  destination            Destination  @relation(fields: [destination_id], references: [id], onDelete: Cascade)
  name                   String
  duration_days          Int
  tagline                String
  cities_covered         String[]
  highlights             String[]
  best_season            String
  budgetTiers            BudgetTier[]
  source                 String       @default("manual")
  aiItineraryId          String?
  copilotSeed            Json?
  isFeatured             Boolean      @default(false)
  region                 String?
  costBreakdownPerPerson Json?

  @@map("travel_packages")
}

model BudgetTier {
  id                 String        @id @default(cuid())
  package_id         String
  package            TravelPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)
  tier_name          String
  price_per_day_usd  Int
  price_per_day_inr  Int
  total_usd          Int
  total_inr          Int
  accommodation      String
  food               String
  transport          String
  includes           String[]

  @@map("budget_tiers")
}

model PriceAlert {
  id            String    @id @default(cuid())
  user_id       String
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  alert_type    String    // 'flight' or 'hotel'
  
  // For flights
  origin        String?   // IATA code
  destination   String?   // IATA code
  travel_date   DateTime?
  
  // For hotels
  hotel_id      String?
  checkin_date  DateTime?
  checkout_date DateTime?
  
  // Pricing
  current_price Float
  target_price  Float
  currency      String    @default("INR")
  
  // State
  status        String    @default("active") // 'active', 'triggered', 'expired'
  notify_email  String
  created_at    DateTime  @default(now())
  triggered_at  DateTime?

  @@map("price_alerts")
}

// ──────────────────────────────────────────────
// WAVE 1 MODELS
// ──────────────────────────────────────────────

// --- 1A: AI Copilot ---
model AiItinerary {
  id             String   @id @default(cuid())
  userId         String
  tripId         String?
  destination    String
  budget         Float
  duration       Int
  travelers      Int      @default(1)
  budgetPerPerson Float?
  data           Json     // full JSON response from DeepSeek
  isShared       Boolean  @default(false)
  selectedFlight Json?
  selectedHotel  Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip           Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// --- 1B: Group Voting ---
model Poll {
  id        String   @id @default(cuid())
  tripId    String
  createdBy String
  question  String
  type      String   // 'destination' | 'hotel' | 'activity' | 'date' | 'custom'
  status    String   @default("open")  // 'open' | 'closed'
  options   PollOption[]
  votes     Vote[]
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  votes  Vote[]
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

model Vote {
  id       String     @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([pollId, userId])  // one vote per user per poll
}

// --- 1C: Expense Splitting ---
model Expense {
  id           String               @id @default(cuid())
  tripId       String
  title        String
  amount       Float
  currency     String               @default("INR")
  category     String               // "hotel"|"food"|"transport"|"activity"|"other"
  date         DateTime             @default(now())
  splitType    String               @default("equal")
  // "equal" | "percentage" | "custom"

  paidById     String               // TripTraveler.id of who paid
  // IMPORTANT: this must be TripTraveler.id, NOT User.id

  participants ExpenseParticipant[]
  trip         Trip                 @relation(fields: [tripId], references: [id])
  paidBy       TripTraveler         @relation(fields: [paidById], references: [id])
}

model ExpenseParticipant {
  id          String       @id @default(cuid())
  expenseId   String
  travelerId  String       // TripTraveler.id — NOT User.id
  share       Float        // amount this traveler owes for this expense
  settled     Boolean      @default(false)
  settledAt   DateTime?

  expense     Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  traveler    TripTraveler @relation(fields: [travelerId], references: [id])

  @@unique([expenseId, travelerId])
}

model Settlement {
  id            String       @id @default(cuid())
  tripId        String
  fromTravelerId String      // TripTraveler.id — who pays
  toTravelerId  String       // TripTraveler.id — who receives
  amount        Float
  settled       Boolean      @default(false)
  settledAt     DateTime?
  trip          Trip         @relation(fields: [tripId], references: [id])
  fromTraveler  TripTraveler @relation("SettlementFrom", fields: [fromTravelerId], references: [id])
  toTraveler    TripTraveler @relation("SettlementTo", fields: [toTravelerId], references: [id])
}

// --- 1D: Travel Journal ---
model Journal {
  id          String         @id @default(cuid())
  tripId      String         @unique
  userId      String
  title       String
  story       String         // AI-generated trip narrative (long text)
  isPublished Boolean        @default(false)
  coverPhoto  String?
  photos      JournalPhoto[]
  likes       JournalLike[]
  comments    JournalComment[]
  createdAt   DateTime       @default(now())
  trip        Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalPhoto {
  id        String  @id @default(cuid())
  journalId String
  url       String
  caption   String?
  dayNumber Int?
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

model JournalLike {
  id        String  @id @default(cuid())
  journalId String
  userId    String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([journalId, userId])
}

model JournalComment {
  id        String   @id @default(cuid())
  journalId String
  userId    String
  text      String
  createdAt DateTime @default(now())
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// TRAVELER INFO
// ──────────────────────────────────────────────

model TripTraveler {
  id          String   @id @default(cuid())
  tripId      String?
  itineraryId String?
  packageId   String?

  // Primary traveler (index 0) = the logged-in user
  // Additional travelers (index 1+) = guests added by the user
  isOwner     Boolean  @default(false)

  name        String
  email       String
  phone       String?
  age         Int?

  // Seat/booking preferences (optional, for future use)
  mealPref    String?  // "veg" | "non-veg" | "jain" | "vegan" | "any"
  seatPref    String?  // "window" | "aisle" | "any"

  createdAt   DateTime @default(now())

  // Wave 1 relations
  expensesPaid       Expense[]
  expenseShares      ExpenseParticipant[]
  settlementsFrom    Settlement[] @relation("SettlementFrom")
  settlementsTo      Settlement[] @relation("SettlementTo")

  @@map("trip_travelers")
}

// ──────────────────────────────────────────────
// WAVE 2: AI TRAVEL AGENT
// ──────────────────────────────────────────────

model AgentJob {
  id                  String   @id @default(cuid())
  userId              String
  userMessage         String
  response            String?
  toolsCalled         String[] @default([])
  messages            Json?    // full conversation history
  conversationHistory Json?    // input conversation context
  status              String   @default("pending")
  // status: "pending" | "processing" | "completed" | "failed"
  error               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_jobs")
}
